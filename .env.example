# --- LLM: Claude (Anthropic) ---
# Ключ из Anthropic Console (https://console.anthropic.com/). Тарификация по
# токенам, это ОТДЕЛЬНЫЙ продукт от подписки Claude Pro/Max — подробности в README.
ANTHROPIC_API_KEY=sk-ant-...

# Модель Claude. По умолчанию самая мощная (claude-opus-5).
# Для шага ingest.py (LLM зовётся на каждый чанк) дешевле/быстрее claude-haiku-4-5.
LLM_MODEL=claude-opus-5

# --- Эмбеддинги: локальная модель ---
# У Claude нет embeddings API, поэтому вектора считаем локально (без ключа).
# Скачается один раз при первом запуске.
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123
NEO4J_DATABASE=neo4j
